# Single required API key for entire AI pipeline (Transcription, NL extraction, Spatial reasoning, Command processing)
GROQ_API_KEY=...

# Models (All hosted on Groq)
AI_PROVIDER=groq
GROQ_LLM_MODEL=qwen/qwen3.8-27b
GROQ_COMMAND_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3


# MQTT Settings
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_KEEPALIVE=60
MQTT_DRY_RUN=true
ENABLED_DEVICES=Light1,Light2
ACK_REQUIRED=false
ACK_TIMEOUT_S=2

# Vision & Camera
CAMERA_ENABLED=true
CAMERA_INDEX=0
CAMERA_WARMUP_FRAMES=20
IMAGE_PATH=images/current_scene.jpg
FORCE_ONBOARDING=true
ANNOTATION_AUTO_ACCEPT=false
TTS_ENABLED=true

PLATFORM_LABEL=laptop
