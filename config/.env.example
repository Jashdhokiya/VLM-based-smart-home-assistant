# ═══════════════════════════════════════════════════════════════════════
# INOT Mark1 — Environment Configuration
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════

# ── Platform ──────────────────────────────────────────────────────────
# pc  = laptop/desktop (default, full onboarding + cloud AI)
# rpi = Raspberry Pi (headless, local AI, no camera onboarding)
PLATFORM=pc
PLATFORM_LABEL=laptop

# ── Speech-to-Text Backend ────────────────────────────────────────────
# vosk           = Offline Vosk (small English model, arm64-compatible)
# faster_whisper = Offline faster-whisper (tiny.en, int8, cpu)
# groq           = Cloud Groq Whisper API (default)
STT_BACKEND=groq
GROQ_WHISPER_MODEL=whisper-large-v3
# VOSK_MODEL_PATH=vosk-model-small-en-us-0.15
# FASTER_WHISPER_MODEL=tiny.en
# FASTER_WHISPER_COMPUTE=int8
# AUDIO_DEVICE=                 # sounddevice device name or index
AUDIO_RATE=16000
AUDIO_CHANNELS=1
AUDIO_RECORD_SECONDS=5

# ── LLM Backend ──────────────────────────────────────────────────────
# ollama = Local via OpenAI-compatible API (http://localhost:11434/v1)
# groq   = Cloud Groq API (default)
LLM_BACKEND=groq
GROQ_API_KEY=...
GROQ_LLM_MODEL=qwen/qwen3.8-27b
GROQ_COMMAND_MODEL=qwen/qwen3.8-27b
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:1.5b
# OLLAMA_FALLBACK_MODEL=qwen2.5:0.5b
# OLLAMA_KEEP_ALIVE=-1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=256
LLM_TIMEOUT_S=30
# LLM_GROQ_FALLBACK=false       # Try Groq if local LLM fails

# ── Legacy AI Provider (for onboarding modules) ──────────────────────
AI_PROVIDER=groq

# ── MQTT Settings ─────────────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_WS_PORT=9001
MQTT_KEEPALIVE=60
MQTT_DRY_RUN=true
MQTT_CLIENT_ID=inot-mark1
ACK_REQUIRED=false
ACK_TIMEOUT_S=2
MQTT_RETRY_COUNT=2
MQTT_RETRY_DELAY_S=0.5

# ── Devices ───────────────────────────────────────────────────────────
ENABLED_DEVICES=Light1,Light2
ROOM_CONTEXT_PATH=room_context.json

# ── Camera / Vision (PC onboarding only) ──────────────────────────────
CAMERA_ENABLED=true
CAMERA_INDEX=0
CAMERA_WARMUP_FRAMES=20
IMAGE_PATH=images/current_scene.jpg
FORCE_ONBOARDING=true
ANNOTATION_AUTO_ACCEPT=false

# ── Audio / TTS ───────────────────────────────────────────────────────
TTS_ENABLED=true

# ── Wake Word / VAD (optional) ────────────────────────────────────────
WAKE_WORD_ENABLED=false

# ── Dashboard Server ─────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# ── Cloud Onboarding Engine (Pi-safe: upload image -> cloud -> JSON) ───
# Provider: groq | gemini | openai | cloud_url
ONBOARDING_PROVIDER=groq
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GEMINI_API_KEY=
# GEMINI_VISION_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_VISION_MODEL=gpt-4o-mini
# CLOUD_ONBOARDING_URL=            # Optional external cloud endpoint
# CLOUD_ONBOARDING_API_KEY=        # Optional Bearer token for CLOUD_ONBOARDING_URL
ONBOARDING_TIMEOUT_S=45
ONBOARDING_MAX_IMAGE_MB=10
ONBOARDING_MAX_IMAGE_DIM=1280
# RPI_SERVER_URL=http://mark1pi.local:8000  # Optional target Pi URL for /api/onboard/push-to-rpi
